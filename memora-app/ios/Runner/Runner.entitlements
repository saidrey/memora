<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- spec09-programar-nfc.md: Near Field Communication Tag Reading
	     capability, required by Core NFC to start an NFC session at all
	     (read OR write) on iOS, in addition to NFCReaderUsageDescription in
	     Info.plist. NDEF and TAG formats are both listed because this app
	     both reads a tag's existing NDEF content (to detect "already has
	     data" before overwriting) and writes a new NDEF message to it. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
		<string>TAG</string>
	</array>
</dict>
</plist>

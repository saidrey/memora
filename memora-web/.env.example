# Base URL of memora-backend's API, including the versioned prefix (/api/v1).
# Defaults to memora-backend's own local default (PORT ?? 3000) if unset.
# NOTE: `next dev` also defaults to port 3000 — if you run both dev servers
# locally at once, start one of them on a different port, e.g.:
#   PORT=3001 npm run dev   (in memora-web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena
# los valores reales. NUNCA pongas secretos reales aquí (este archivo SÍ se
# sube a git).

# Google OAuth (cliente Web, usado por el backend para canjear el serverAuthCode
# — ver specs/memora-backend/spec02-autenticacion-google.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firma los JWT de sesión propios de Memora (access + refresh). Usa una
# cadena aleatoria larga en cada entorno; nunca commitees un valor real.
JWT_SESSION_SECRET=

# Opcional — valores por defecto mostrados. Formato de duración jsonwebtoken (p. ej. 15m, 30d).
JWT_SESSION_ACCESS_TTL=15m
JWT_SESSION_REFRESH_TTL=30d

# Colaboradores (spec05-colaboradores.md) — opcionales, valores por defecto
# mostrados. APP_INVITE_BASE_URL debe contener el placeholder {token}; el
# backend nunca hardcodea el dominio.
APP_INVITE_BASE_URL=https://memora.app/invite/{token}
INVITATION_TTL_DAYS=7

# Compartir y visor (spec09-compartir-visor.md) — opcional, valor por
# defecto mostrado. Debe contener el placeholder {token}, igual que
# APP_INVITE_BASE_URL.
APP_SHARE_BASE_URL=https://memora.app/s/{token}

# NFC/QR (spec10-nfc-qr.md) — opcional, valor por defecto mostrado. Es una
# variable PROPIA, distinta de APP_SHARE_BASE_URL (aunque la spec la
# menciona como si fuera la misma) porque tiene una forma de URL distinta
# (/n/ en vez de /s/) — ver README.md, sección "NFC/QR (spec10-nfc-qr)".
APP_NFC_QR_BASE_URL=https://memora.app/n/{token}

# PostgreSQL (Neon: direct URL for migrations, pooled URL for the app).
# sslmode=require is expected in both connection strings.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_URL_POOLED=postgres://user:password@host-pooler/db?sslmode=require
# Optional alias for the direct migration URL.
DATABASE_DIRECT_URL=
# 32 bytes encoded as base64 or 64 hexadecimal characters. Required in prod.
TOKEN_ENCRYPTION_KEY=
